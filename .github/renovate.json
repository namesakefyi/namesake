{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":widenPeerDependencies",
    "docker:pinDigests",
    "group:linters",
    "group:test",
    "group:vite",
    "helpers:pinGitHubActionDigestsToSemver",
    "mergeConfidence:all-badges"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "4 days",
  "schedule": ["* * 1-2,15-16 * *"],
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "groupName": "ci",
      "matchManagers": ["github-actions", "devcontainer"]
    },
    {
      "groupName": "astro",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["astro", "@astrojs/**"]
    },
    {
      "description": "Don't update Node.js engines field (needed because of the use of rangeStrategy: 'bump' above)",
      "matchPackageNames": ["node"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Major updates wait for approval in the Dependency Dashboard instead of opening PRs automatically",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "description": "Bundles all non-major updates into one PR.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "replacement"
      ]
    },
    {
      "description": "Treat 0.x minor updates as breaking: ungroup them from all-minor-patch and require Dependency Dashboard approval",
      "matchCurrentVersion": "<1",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "dependencyDashboardApproval": true
    }
  ]
}
