  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "wrangler types --check && astro check && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=html",
    "check-links": "lychee --config .lychee.toml .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "idb:add-migration": "node scripts/create-idb-migration.mjs"
  },
  "imports": {
