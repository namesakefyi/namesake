---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  logo: ImageMetadata;
  class?: string;
}

const { logo, class: className, ...rest } = Astro.props;
---

<Image
  class:list={["directory-logo", className]}
  src={logo}
  alt=""
  width={300}
  densities={[1, 2]}
  {...rest}
/>

<style>
  .directory-logo {
    object-fit: contain;
    object-position: left;
    mix-blend-mode: multiply;
    filter: grayscale(100%);
  }
</style>
