<script>
  import { siteInfo } from "#constants/site-info";
  import { openDonatePopover } from "#lib/donate/openDonatePopover";
  import { parseDonateOptions } from "#lib/utils/parseDonateOptions";

  // Donate links point at /donate, which redirects to Every.org for new-tab
  // clicks and no-JS visitors; plain clicks open the popover instead.
  document.addEventListener("click", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }

    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
      "a[href]",
    );
    if (!link || link.target === "_blank") return;

    const url = new URL(link.href);
    const isSiteOrigin = [
      window.location.origin,
      new URL(import.meta.env.SITE).origin,
    ].includes(url.origin);
    if (!isSiteOrigin || url.pathname !== siteInfo.urls.donate) return;

    event.preventDefault();

    openDonatePopover(parseDonateOptions(url.searchParams)).catch(() => {
      window.location.href = link.href;
    });
  });
</script>
