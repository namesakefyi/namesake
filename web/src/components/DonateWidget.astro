<script>
  import type { DonationFrequency } from "#constants/donation";
  import { openDonateWidget } from "#lib/donate/openDonateWidget";

  // Donate links stay real links to Every.org so new-tab clicks and
  // no-JS visitors still work; plain clicks open the popup instead.
  document.addEventListener("click", (event) => {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }

    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>(
      "a[data-donate]",
    );
    if (!link) return;

    event.preventDefault();

    const { searchParams } = new URL(link.href);
    const amount = Number(searchParams.get("amount")) || undefined;
    const frequency = (searchParams.get("frequency") ?? undefined) as
      | DonationFrequency
      | undefined;

    openDonateWidget({ amount, frequency }).catch(() => {
      window.location.href = link.href;
    });
  });
</script>
