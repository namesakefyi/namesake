---
import {
  DONATION_FREQUENCIES,
  type DonationFrequency,
  siteInfo,
} from "#constants/site-info";
import { buildDonatePath } from "#lib/utils/buildDonatePath";
import { formatCurrency } from "#lib/utils/formatCurrency";

interface Props {
  class?: string;
}

const { class: className, ...rest } = Astro.props;
const { donation, fiscalSponsor } = siteInfo;

const DEFAULT_FREQUENCY: DonationFrequency = "monthly";

const FREQUENCY_LABELS: Record<DonationFrequency, string> = {
  yearly: "Yearly",
  monthly: "Monthly",
  once: "Once",
};
---

<section
  class:list={["donation-banner", className]}
  aria-labelledby="donation-banner-title"
  data-inverted
  data-no-print
  {...rest}
>
  <div class="pitch">
    <h2 id="donation-banner-title">
      Keep Namesake free for <span class="highlight">everyone</span>
    </h2>
    <p>
      Namesake has no ads and requires no login. Donations from people like you
      fund our work to simplify the legal name change process.
    </p>
  </div>
  <div class="give">
    <fieldset class="frequency">
      <legend class="visually-hidden">Donation frequency</legend>
      {DONATION_FREQUENCIES.map((frequency) => (
        <label>
          <input
            class="visually-hidden"
            type="radio"
            name="donation-frequency"
            value={frequency}
            checked={frequency === DEFAULT_FREQUENCY}
          />
          {FREQUENCY_LABELS[frequency]}
        </label>
      ))}
    </fieldset>
    <ul class="amounts">
      {[...donation.suggestedAmounts, undefined].map((amount) => (
        <li>
          <a
            class="button secondary"
            href={buildDonatePath({ amount, frequency: DEFAULT_FREQUENCY })}
          >
            {amount ? formatCurrency(amount) : "Other"}
          </a>
        </li>
      ))}
    </ul>
    <p class="fine-print">
      Namesake is a fiscally sponsored project of{" "}
      <a href={fiscalSponsor.url}>{fiscalSponsor.name}</a>, a 501(c)(3)
      nonprofit. Donations are tax-deductible to the extent allowed by law.
    </p>
  </div>
</section>

<script>
  import { annotate } from "rough-notation";

  const banner = document.querySelector<HTMLElement>(".donation-banner");

  if (banner) {
    annotate(banner, {
      type: "box",
      iterations: 1,
      animate: false,
      padding: 2,
      strokeWidth: 2,
    }).show();
  }

  const highlight = document.querySelector<HTMLElement>(
    ".donation-banner .highlight",
  );

  if (highlight) {
    annotate(highlight, {
      type: "underline",
      iterations: 2,
      padding: 0,
      strokeWidth: 2,
    }).show();
  }

  const frequencyGroup = document.querySelector<HTMLFieldSetElement>(
    ".donation-banner .frequency",
  );
  const amountLinks = document.querySelectorAll<HTMLAnchorElement>(
    ".donation-banner .amounts a",
  );

  frequencyGroup?.addEventListener("change", (event) => {
    const { value } = event.target as HTMLInputElement;

    for (const link of amountLinks) {
      const url = new URL(link.href);
      url.searchParams.set("frequency", value);
      link.href = url.pathname + url.search;
    }
  });
</script>

<style>
  .donation-banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    width: 100%;
    max-width: 1200px;
    padding: var(--space-xl);
    border-radius: var(--radius-2xs);

    @media (width < 860px) {
      grid-template-columns: 1fr;
    }
  }

  .pitch {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);

    h2 {
      font-size: var(--step-3);
      text-wrap: balance;
    }

    p {
      font-size: var(--step-0);
      text-wrap: pretty;
    }
  }

  .give {
    --control-border-width: 1px;

    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .frequency {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: none;

    label {
      position: relative;
      padding: var(--space-2xs) var(--space-m);
      text-align: center;
      cursor: pointer;
      border: var(--control-border-width) solid var(--text-color);

      &:first-of-type {
        border-start-start-radius: var(--radius-2xs);
        border-end-start-radius: var(--radius-2xs);
      }

      /* Overlap the shared border so it doesn't double up */
      &:not(:first-of-type) {
        margin-inline-start: calc(var(--control-border-width) * -1);
      }

      &:last-of-type {
        border-start-end-radius: var(--radius-2xs);
        border-end-end-radius: var(--radius-2xs);
      }

      &:has(:checked) {
        color: var(--background-color);
        background-color: var(--text-color);
      }

      &:has(:focus-visible) {
        z-index: 1;
        outline: 3px solid var(--focus-ring-color);
        outline-offset: 2px;
      }
    }
  }

  .amounts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 0;
    margin: 0;
    list-style: none;

    --outer-radius: var(--radius-2xs);

    /* Overlap shared borders so they don't double up */
    li:not(:first-child) {
      margin-inline-start: calc(var(--control-border-width) * -1);
    }

    li:first-child .button {
      border-start-start-radius: var(--outer-radius);
      border-end-start-radius: var(--outer-radius);
    }

    li:last-child .button {
      border-start-end-radius: var(--outer-radius);
      border-end-end-radius: var(--outer-radius);
    }

    @container (width < 30rem) {
      grid-template-columns: repeat(4, 1fr);

      li:last-child {
        grid-column: 1 / -1;
        margin-block-start: calc(var(--control-border-width) * -1);
        margin-inline-start: 0;
      }

      li:first-child .button {
        border-end-start-radius: 0;
      }

      li:nth-last-child(2) .button {
        border-start-end-radius: var(--outer-radius);
      }

      li:last-child .button {
        border-start-end-radius: 0;
        border-end-start-radius: var(--outer-radius);
      }
    }

    .button {
      position: relative;
      padding-inline: var(--space-s);
      border-width: var(--control-border-width);
      border-radius: 0;

      &:hover,
      &:focus-visible {
        z-index: 1;
      }
    }
  }

  .fine-print {
    font-size: var(--step--2);
  }
</style>
