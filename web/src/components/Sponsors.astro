---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const sponsors = await getCollection("sponsors");
const shuffledSponsors = sponsors.sort(() => 0.5 - Math.random());
---

<section class="sponsors">
  <h2>Support from</h2>
  <ul>
    {shuffledSponsors.map(({ data }) => (
      <li>
        <a href={data.url} aria-label={`Visit ${data.name}`}>
          <Image
            src={data.logo}
            alt={data.name}
            width={200}
            densities={[1, 2]}
          />
        </a>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  .sponsors {
    display: flex;
    align-items: center;
    flex-direction: column;
    margin-inline: auto;
    width: 100%;
    max-width: 100vw;
    gap: var(--space-3xl);
    padding-block: var(--space-3xl);

    ul {
      --row-height: 80px;
      list-style-type: none;
      margin: 0;
      padding: 0;
      max-width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-l) var(--space-xl);
      user-select: none;

      li {
        min-height: 0;
        line-height: 0;
      }

      a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
      }

      img {
        display: block;
        width: 200px;

        @supports (object-fit: contain) {
          height: var(--row-height);
          object-fit: contain;
        }
      }

      @media (forced-colors: active) {
        filter: invert(1);
      }
    }
  }
</style>
