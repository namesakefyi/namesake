---
import { RiArrowRightLine } from "@remixicon/react";
---

<form
  action="https://buttondown.com/api/emails/embed-subscribe/namesake"
  method="post"
  class="embeddable-buttondown-form"
>
  <label for="bd-email">Keep in touch</label>
  <div class="input-group">
    <input
      type="email"
      name="email"
      id="bd-email"
      placeholder="Your email"
      autocomplete="email"
      required
    />
    <button type="submit">Subscribe <RiArrowRightLine /></button>
  </div>
</form>

<style>
  form {
    position: relative;
    border-radius: var(--radius-xs);
    width: 100%;
    max-width: 520px;
  }

  .input-group {
    max-width: 100%;
    display: flex;
    gap: var(--space-xs);
    margin-block-start: var(--space-s);
  }

  label {
    font-weight: var(--weight-bold);
  }

  input,
  button {
    border: none;
    border-radius: var(--radius-xs);
    color: var(--highlight-foreground);
    padding: var(--space-xs) var(--space-s);
  }

  /* An input can't hold a ::before layer, but has no content to drop */
  input {
    flex: 1;
    min-width: 0;
    background: var(--highlight-background);
    mask: var(--grain-edge-small);

    /* The mask would clip the focus ring drawn outside the border box */
    &:focus-visible {
      mask: none;
    }

    &::placeholder {
      color: color-mix(in srgb, var(--highlight-foreground) 50%, transparent);
    }
  }

  button {
    position: relative;
    isolation: isolate;
    background: none;
    font-weight: var(--weight-bold);
    flex-shrink: 0;
    cursor: pointer;
    display: inline-flex;
    gap: var(--space-2xs);
    align-items: center;
    padding-inline: var(--space-m);

    &::before {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      content: "";
      background: var(--highlight-background);
      border-radius: inherit;
      mask: var(--grain-edge-small);
    }
  }
</style>
