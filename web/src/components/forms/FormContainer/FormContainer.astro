---
import { getEntry } from "astro:content";
import { getFormPdfMetadata } from "#lib/forms/getFormPdfMetadata";
import { FormContainer as ReactFormContainer } from "./FormContainer";

interface Props {
  formId: string;
  inline?: boolean;
}

const { formId, inline = true } = Astro.props;
const entry = await getEntry("forms", formId);
if (!entry) throw new Error(`No form found with id: ${formId}`);
const pdfMetadata = getFormPdfMetadata(formId);
const { title, description, costs } = entry.data;
---

<ReactFormContainer
  client:load
  formId={formId}
  inline={inline}
  title={title}
  description={description}
  costs={costs}
  pdfMetadata={pdfMetadata}
>
  <slot />
</ReactFormContainer>
