---
import { allForms } from "#lib/forms/allForms";
import { FormContainer as ReactFormContainer } from "./FormContainer";

interface Props {
  formId: string;
  inline?: boolean;
}

const { formId, inline = true } = Astro.props;
const config = allForms[formId];
if (!config) throw new Error(`No form found with id: ${formId}`);
const { title, description, costs, steps, download } = config;
const form = {
  id: formId,
  title,
  description,
  costs,
  stepCount: steps.length,
  pdfs: download.pdfs.map(({ pdf: { title, code, file } }) => ({
    title,
    code,
    file,
  })),
};
---

{
  import.meta.env.PROD && (
    <link rel="modulepreload" data-form-module={formId} />
  )
}
<ReactFormContainer
  client:load
  form={form}
  inline={inline}
>
  <slot />
</ReactFormContainer>
