---
import type { RoughAnnotationType } from "rough-notation/lib/model";
import type { BreadcrumbItem } from "#components/Breadcrumbs.astro";
import PageHeader from "#components/PageHeader.astro";
import type { NamesakeColor } from "#constants/colors";
import { smartquotes } from "#lib/utils/smartquotes";
import BaseLayout from "./BaseLayout.astro";
import "../styles/prose.css";

interface Props {
  title: string;
  searchTitle?: string;
  date?: string;
  description?: string | null;
  showDescription?: boolean;
  author?: string;
  previewImage?: {
    src: string;
    alt: string;
  };
  annotation?: RoughAnnotationType | null;
  color?: NamesakeColor | null;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  searchTitle,
  date,
  description,
  showDescription,
  author,
  previewImage,
  annotation,
  color,
  breadcrumbs,
} = Astro.props;

const headerDescription =
  showDescription === false
    ? undefined
    : description && smartquotes(description);
---

<BaseLayout
  title={title}
  description={description && smartquotes(description)}
  author={author}
  previewImage={previewImage}
  color={color}
>
  <article
    class="article-grid"
    itemscope
    itemtype="https://schema.org/BlogPosting"
  >
    <PageHeader
      title={title}
      searchTitle={searchTitle}
      date={date}
      description={headerDescription}
      annotation={annotation}
      breadcrumbs={breadcrumbs}
    />
    <slot name="after-header" />
    <section class="toc" data-no-print>
      <slot name="toc" />
    </section>
    <section itemprop="articleBody" class="prose">
      <slot />
    </section>
    <slot name="after-content" />
  </article>
</BaseLayout>

<script>
  import { annotate } from "rough-notation";

  const blockquotes = document.querySelectorAll("blockquote");

  if (blockquotes) {
    for (const blockquote of blockquotes) {
      const highlight = annotate(blockquote, {
        type: "bracket",
        iterations: 2,
        animate: false,
        brackets: ["left"],
      });
      highlight.show();
    }
  }

  const cites = document.querySelectorAll("cite");
  if (cites) {
    for (const cite of cites) {
      cite.style.color = "var(--background-color)";
      const highlight = annotate(cite, {
        type: "highlight",
        iterations: 1,
        animate: false,
        multiline: true,
        strokeWidth: 2,
      });
      highlight.show();
    }
  }

  const dividers = document.querySelectorAll("hr");
  if (dividers) {
    for (const divider of dividers) {
      const highlight = annotate(divider, {
        type: "underline",
        iterations: 1,
        animate: false,
      });
      highlight.show();
    }
  }
</script>
