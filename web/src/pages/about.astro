---
import {
  RiContractLine,
  RiEdit2Line,
  RiHandHeartLine,
  RiInputField,
  RiSearchLine,
} from "@remixicon/react";
import DonateBanner from "#components/DonateBanner.astro";
import PageHeader from "#components/PageHeader.astro";
import Testimonials from "#components/Testimonials.astro";
import BaseLayout from "#layouts/BaseLayout.astro";
import { randomTilt } from "#lib/utils/randomTilt";
import AboutSection from "./about/_components/AboutSection.astro";
import ImpactStats from "./about/_components/ImpactStats.astro";
import TeamGrid from "./about/_components/TeamGrid.astro";
import WhatWeDoArrowLeft from "./about/_components/what-we-do-arrow-left.svg";
import WhatWeDoArrowRight from "./about/_components/what-we-do-arrow-right.svg";
---

<BaseLayout title="About" description="Meet the team behind Namesake.">
  <PageHeader
    title="About Namesake"
    description="Namesake is a small, trans-led team of organizers and technologists working to simplify legal name and gender marker changes
  in the U.S."
  />
  <AboutSection heading="Mission" class="mission">
    <p class="lead">
      Namesake simplifies the process of changing legal names and gender markers
      for trans people in the U.S.
    </p>
    <h3>
      <WhatWeDoArrowLeft aria-hidden="true" />
      <span style={`rotate: ${randomTilt()}`}>What we do</span>
      <WhatWeDoArrowRight aria-hidden="true" />
    </h3>
    <ul>
      <li>
        <RiSearchLine aria-hidden="true" />
        <p>
          <strong>Research laws</strong> in all states and advocate for legal
          change.
        </p>
      </li>
      <li>
        <RiEdit2Line aria-hidden="true" />
        <p>
          <strong>
            Write <a href="/guides">guides</a>
          </strong>{" "}
          in plain language to explain what .gov sites don't (or won't).
        </p>
      </li>
      <li>
        <RiContractLine aria-hidden="true" />
        <p>
          <strong>
            Build <a href="/forms">forms</a>
          </strong>{" "}
          to help fill out court petitions, fee waivers, and more.
        </p>
      </li>
      <li>
        <RiHandHeartLine aria-hidden="true" />
        <p>
          <strong>Partner regionally</strong> with{" "}
          <a href="/directory">orgranizations</a> who offer additional
          assistance.
        </p>
      </li>
    </ul>
  </AboutSection>
  <AboutSection heading="Vision">
    <p class="lead">
      To promote the freedom of <span class="nowrap">self-determination</span>{" "}
      for all.
    </p>
  </AboutSection>
  <AboutSection heading="Impact">
    <ImpactStats />
  </AboutSection>
  <AboutSection heading="Team" class="team">
    <TeamGrid />
  </AboutSection>
  <DonateBanner class="donation" />
  <Testimonials class="testimonials-section" />
</BaseLayout>

<style>
  .lead {
    max-width: 60ch;
    font-size: var(--step-3);
    line-height: var(--line-height-display);
  }

  .mission {
    h3 {
      position: relative;
      width: fit-content;
      font-size: var(--step-0);
      margin-block-start: var(--space-xl);

      span {
        display: inline-block;
      }

      svg {
        position: absolute;
        inset-block-start: 0.35em;
        width: var(--step-4);
        height: auto;
      }

      svg:first-child {
        display: none;
        inset-inline-end: calc(100% + var(--space-2xs));
      }

      svg:last-child {
        inset-inline-start: calc(100% + var(--space-2xs));
      }

      /* Once the viewport is wider than main's 1200px max, the left gutter has room for the arrow */
      @media (width >= 1300px) {
        svg:first-child {
          display: block;
        }

        svg:last-child {
          display: none;
        }
      }
    }

    ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
      padding: 0;
      margin: var(--space-l) 0 0;
      list-style-type: none;

      @media (width >= 900px) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    li {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    svg {
      width: var(--step-3);
      height: var(--step-3);
    }

    strong {
      font-size: var(--step-1);
      line-height: var(--line-height-single);
    }
  }

  .team {
    padding-block-end: var(--space-3xl);
  }

  .donation {
    margin-block-end: var(--space-3xl);
  }

  .testimonials-section {
    padding-block-end: var(--space-3xl);
  }
</style>
