---
import DonateBanner from "#components/DonateBanner.astro";
import PageHeader from "#components/PageHeader.astro";
import Testimonials from "#components/Testimonials.astro";
import BaseLayout from "#layouts/BaseLayout.astro";
import { randomTilt } from "#lib/utils/randomTilt";
import AboutSection from "./about/_components/AboutSection.astro";
import ImpactStats from "./about/_components/ImpactStats.astro";
import TeamGrid from "./about/_components/TeamGrid.astro";
---

<BaseLayout title="About" description="Meet the team behind Namesake.">
  <PageHeader
    title="About Namesake"
    description="Namesake is a small, trans-led team of organizers and technologists working to simplify legal name and gender marker changes
  in the U.S."
  />
  <AboutSection heading="Mission" class="mission">
    <p class="lead">
      Namesake simplifies the process of changing legal names and gender markers
      for trans people in the U.S.
    </p>
    <h3>
      <span style={`rotate: ${randomTilt()}`}>What we do</span>
    </h3>
    <ul>
      <li>
        <div class="placeholder-image" aria-hidden="true"></div>
        <p>
          <strong>Research</strong> legislative shifts across the U.S. and
          advocate for legal change to simplify the process.
        </p>
      </li>
      <li>
        <div class="placeholder-image" aria-hidden="true"></div>
        <p>
          <strong>Write</strong> <a href="/guides">guides</a> using plain
          language to explain what isn't covered on most .gov websites.
        </p>
      </li>
      <li>
        <div class="placeholder-image" aria-hidden="true"></div>
        <p>
          <strong>Build</strong> <a href="/forms">forms</a> that help people
          securely fill out court petitions, fee waivers, and more.
        </p>
      </li>
      <li>
        <div class="placeholder-image" aria-hidden="true"></div>
        <p>
          <strong>Partner</strong> with regional LGBTQ+{" "}
          <a href="/directory">orgranizations</a> who offer additional legal and
          financial assistance.
        </p>
      </li>
    </ul>
  </AboutSection>
  <AboutSection heading="Vision">
    <p class="lead">
      To promote the freedom of <span class="nowrap">self-determination</span>{" "}
      for all.
    </p>
  </AboutSection>
  <AboutSection heading="Impact">
    <ImpactStats />
  </AboutSection>
  <AboutSection heading="Team" class="team">
    <TeamGrid />
  </AboutSection>
  <DonateBanner class="donation" />
  <Testimonials class="testimonials-section" />
</BaseLayout>

<style>
  .lead {
    max-width: 60ch;
    font-size: var(--step-3);
    line-height: var(--line-height-display);
  }

  .mission {
    h3 {
      display: flex;
      gap: var(--space-s);
      font-size: var(--step-0);
      align-items: baseline;
      margin-block-start: var(--space-xl);

      span {
        display: inline-block;
      }

      &::after {
        flex: 1;
        content: "";
        border-block-start: 2px solid var(--border-color);
      }
    }

    ul {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-l);
      padding: 0;
      margin: var(--space-m) 0 0;
      list-style-type: none;

      @media (width >= 480px) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @media (width >= 900px) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    li {
      display: flex;
      flex-direction: column;
      gap: var(--space-m);
    }

    strong {
      font-size: var(--step-1);
      line-height: var(--line-height-single);
    }

    .placeholder-image {
      aspect-ratio: 4 / 3;
      background-color: color-mix(in srgb, var(--text-color) 10%, transparent);
      border-radius: var(--radius-2xs);
    }
  }

  .team {
    padding-block-end: var(--space-3xl);
  }

  .donation {
    margin-block-end: var(--space-3xl);
  }

  .testimonials-section {
    padding-block-end: var(--space-3xl);
  }
</style>
