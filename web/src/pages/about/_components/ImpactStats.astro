---
import { getCollection } from "astro:content";
import { siteInfo } from "#constants/site-info";
import { allForms } from "#lib/forms/allForms";

const NAME_CHANGES_ASSISTED = "1,000+";

const [guides, directoryEntries] = await Promise.all([
  getCollection("guides", ({ data }) => !data.unlisted),
  getCollection("directory"),
]);

const formatCount = (count: number) => count.toLocaleString("en-US");

const stats = [
  {
    value: NAME_CHANGES_ASSISTED,
    label: "Name changes assisted",
  },
  {
    value: formatCount(guides.length),
    label: "Guides",
    href: siteInfo.urls.guides,
  },
  {
    value: formatCount(
      Object.values(allForms).filter((form) => !form.unlisted).length,
    ),
    label: "Forms",
    href: siteInfo.urls.forms,
  },
  {
    value: formatCount(directoryEntries.length),
    label: "Organizations",
    href: siteInfo.urls.directory,
  },
];
---

<ul class="stats">
  {stats.map(({ value, label, href }) => {
    const Element = href ? "a" : "div";
    return (
      <li>
        <Element href={href}>
          <strong>{value}</strong>
          <span>{label}</span>
        </Element>
      </li>
    );
  })}
</ul>

<style>
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl) var(--space-2xl);
    padding: 0;
    margin: 0;
    list-style-type: none;

    a,
    div {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      text-decoration: none;
    }

    a span {
      text-decoration: underline;
      text-decoration-color: var(--text-color-muted);
      text-underline-offset: max(0.1em, 2.5px);
    }

    strong {
      font-size: var(--step-5);
      line-height: var(--line-height-single);
      letter-spacing: var(--letter-spacing-condensed);
    }
  }
</style>
