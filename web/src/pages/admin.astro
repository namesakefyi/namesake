---
// Sveltia CMS admin. Kept free of site layouts and global styles,
// which would conflict with the CMS UI.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Namesake CMS</title>
  </head>
  <body>
    <script>
      import { init } from "@sveltia/cms";
      import { cmsConfig } from "#lib/cms/config";
      import "#lib/cms/preview";

      init({ config: cmsConfig });
    </script>
  </body>
</html>
