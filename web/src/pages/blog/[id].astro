---
import { Image } from "astro:assets";
import {
  type CollectionEntry,
  getCollection,
  getEntry,
  render,
} from "astro:content";
import AuthorBios from "#components/AuthorBios.astro";
import DonateBanner from "#components/DonateBanner.astro";
import TableOfContents from "#components/TableOfContents.astro";
import ProseLayout from "#layouts/ProseLayout.astro";
import { joinParts } from "#lib/utils/joinParts";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { id } = Astro.params;

const { Content, headings } = await render(post);

const authorEntries = await Promise.all(
  (post.data.authors ?? []).map((id) => getEntry("authors", id)),
);
const authors = authorEntries.filter(
  (a): a is NonNullable<typeof a> => a !== undefined,
);

const previewImage = {
  src: post.data.image ? post.data.image.src.src : `/blog/${id}.png`,
  alt: post.data.image?.alt ?? post.data.title,
};
---

<ProseLayout
  title={post.data.title}
  date={post.data.publishDate.toISOString()}
  description={post.data.description}
  showDescription={post.data.showDescription}
  previewImage={previewImage}
  author={authors.map((a) => a.data.name).join(", ")}
  color="blue"
  annotation={post.data.annotation ?? "highlight"}
>
  {authors.length > 0 && (
    <div class="authors" slot="after-header">
      {authors.map((author) => (
        <span class="author">
          <Image
            class="avatar author-avatar"
            src={author.data.avatar}
            alt={`${author.data.name} photo`}
            width={32}
            height={32}
            densities={[1, 2]}
          />
          <div class="author-info">
            <strong data-pagefind-filter="author">{author.data.name}</strong>
            <span class="role">
              {joinParts(author.data.org.role, author.data.org.name)}
            </span>
          </div>
        </span>
      ))}
    </div>
  )}
  <TableOfContents slot="toc" headings={headings} />
  <Content />
  <AuthorBios slot="after-content" authors={authors} />
  <DonateBanner slot="after-article" class="donation" />
</ProseLayout>

<style>
  .authors {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding-bottom: var(--space-2xl);
  }

  .author {
    display: inline-flex;
    gap: var(--space-s);
    align-items: center;
  }

  .author-info {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: baseline;

    @media (width <= 600px) {
      flex-direction: column;
      gap: 0;
    }
  }

  .role {
    font-size: var(--step--1);
  }

  .author-avatar {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    object-fit: cover;
  }

  .donation {
    margin-block: var(--space-3xl);
  }
</style>
