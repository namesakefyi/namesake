---
import FormLink from "#components/FormLink.astro";
import PageHeader from "#components/PageHeader.astro";
import BaseLayout from "#layouts/BaseLayout.astro";
import { allForms } from "#lib/forms/allForms";
import { formatTimeEstimate } from "#lib/utils/formatTimeEstimate";

const listedForms = Object.entries(allForms).filter(
  ([, form]) => !form.unlisted,
);
---

<BaseLayout
  title="Forms"
  description="Namesake's guided forms can help you fill out all the name change documents you need to file."
  color="white"
  previewImage={{
    src: "/og/forms.png",
    alt: "Browse Namesake's form library.",
  }}
>
  <PageHeader
    title="Forms"
    description="Namesake's guided forms can help you fill out all the name change documents you need to file."
  />
  <div class="forms">
    {
      listedForms.length ? (
        listedForms.map(([formId, form]) => (
          <FormLink
            title={form.title}
            formId={formId}
            documentCount={form.download.pdfs.length}
            timeEstimate={formatTimeEstimate(form.steps.length)}
          />
        ))
      ) : (
        <p>No forms found.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .forms {
    display: grid;
    gap: var(--space-m);
    padding-block-end: var(--space-2xl);
    grid-template-columns: 1fr 1fr;

    @media (width > 600px) {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--space-l);
    }

    @media (width > 1000px) {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
