---
import FormContainer from "#components/forms/FormContainer/FormContainer.astro";
import type { FormMeta } from "#constants/forms";
import BaseLayout from "#layouts/BaseLayout.astro";
import { allForms } from "#lib/forms/allForms";

export function getStaticPaths() {
  return Object.entries(allForms).map(([id, form]) => ({
    params: { id },
    props: { form },
  }));
}

interface Props {
  form: FormMeta;
}

const { id } = Astro.params;
const { title, description } = Astro.props.form;
---

<BaseLayout
  title={title}
  description={description}
  color="white"
  previewImage={{
    src: `/forms/${id}.png`,
    alt: title,
  }}
>
  <FormContainer formId={id} inline={false} />
</BaseLayout>
