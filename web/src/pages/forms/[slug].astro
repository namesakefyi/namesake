---
import { type CollectionEntry, getCollection } from "astro:content";
import FormContainer from "#components/forms/FormContainer/FormContainer.astro";
import type { FormSlug } from "#constants/forms";
import BaseLayout from "#layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const forms = await getCollection("forms");
  return forms.map((form) => ({ params: { slug: form.id }, props: { form } }));
}

interface Props {
  form: CollectionEntry<"forms">;
}

const { form } = Astro.props;
const { slug } = Astro.params;
const { title, description } = form.data;
---

<BaseLayout
  title={title}
  description={description}
  color="white"
  previewImage={{
    src: `/forms/${slug}.png`,
    alt: title,
  }}
>
  <FormContainer slug={form.id as FormSlug} inline={false} />
</BaseLayout>
